# --- Flask ---
# Use "production" on Vercel, "development" locally
FLASK_ENV=production
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-this-to-a-long-random-string

# --- Database (Neon PostgreSQL) ---
# Example Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tn_one

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production: https://tnforbus.vercel.app/api/auth/callback
# Local dev:  http://localhost:5000/api/auth/callback
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# --- Frontend origin (for CORS + post-login redirect) ---
# Production: https://your-app.vercel.app
# Local dev:  http://localhost:8080
FRONTEND_ORIGIN=https://your-app.vercel.app

# --- Cookies ---
# Must be "true" in production (HTTPS); use "false" only for local HTTP dev
SESSION_COOKIE_SECURE=true

# --- Rate limiting storage ---
# WARNING: memory:// is broken on Vercel (stateless functions) — limits won't persist.
# Get a free Redis at https://upstash.com and set the connection URL here.
RATELIMIT_STORAGE_URI=redis://default:<password>@<host>:6379

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=bus-photos
