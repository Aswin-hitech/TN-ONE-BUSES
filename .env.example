# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# --- Database (Neon PostgreSQL) ---
# Example Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tn_one

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# --- Frontend origin (for CORS + post-login redirect) ---
FRONTEND_ORIGIN=http://localhost:8080

# --- Cookies ---
SESSION_COOKIE_SECURE=false

# --- Rate limiting storage (use redis:// in production for multi-instance) ---
RATELIMIT_STORAGE_URI=memory://

# --- Supabase Storage (optional until photo uploads are enabled) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=bus-photos
